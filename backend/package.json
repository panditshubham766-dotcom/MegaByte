{
  "name": "smart-attendance-backend",
  "version": "1.0.0",
  "description": "Backend API for the Smart Attendance System",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "test:geo": "node --experimental-strip-types test_geo.ts",
    "test:wifi": "node --experimental-strip-types test_wifi.ts",
    "test:verification": "node --experimental-strip-types test_verification.ts",
    "test:enforcement": "node --experimental-strip-types test_enforcement.ts",
    "test:e2e": "node --experimental-strip-types test_e2e.ts",
    "test": "node --experimental-strip-types test_geo.ts && node --experimental-strip-types test_wifi.ts && node --experimental-strip-types test_verification.ts && node --experimental-strip-types test_enforcement.ts && node --experimental-strip-types test_e2e.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.11.5",
    "pngjs": "^7.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/pngjs": "^6.0.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
